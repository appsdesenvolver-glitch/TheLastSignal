 "ch2_edith": {
  "steps": [
   {
    "c": "cam",
    "x": 1000,
    "zoom": 1.3,
    "t": 1.2
   },
   {
    "c": "say",
    "who": "edith",
    "text": "Uma e pouco da manhã. Você veio. Eu prometi contar o que pudesse.",
    "expr": "sad"
   },
   {
    "c": "say",
    "who": "edith",
    "text": "Eu morri no dia trinta e um de outubro de setenta e nove. Fui levar café para os plantonistas do Santa Inês.",
    "expr": "sad"
   },
   {
    "c": "say",
    "who": "edith",
    "text": "Acordei atrás do balcão no dia seguinte. E no outro. E no outro. Por vinte e cinco anos.",
    "expr": "sad"
   },
   {
    "c": "flicker",
    "t": 1.0
   },
   {
    "c": "choice",
    "prompt": "Edith olha para você, esperando.",
    "who": "edith",
    "options": [
     {
      "text": "Você é uma assombração. Esta cidade precisa saber.",
      "do": {
       "trust": {
        "edith": -3
       },
       "set": "edith_accused"
      },
      "then": [
       {
        "c": "ghost",
        "who": "edith",
        "on": true
       },
       {
        "c": "sfx",
        "name": "glitch"
       },
       {
        "c": "say",
        "who": "edith",
        "text": "Então conte. E veja quantos vão acreditar.",
        "expr": "neutral"
       },
       {
        "c": "ghost",
        "who": "edith",
        "on": false
       }
      ]
     },
     {
      "text": "Seu segredo está seguro comigo.",
      "do": {
       "trust": {
        "edith": 3
       },
       "set": "edith_secret"
      },
      "then": [
       {
        "c": "say",
        "who": "edith",
        "text": "...Obrigada. Você não sabe o que é ser invisível por dentro.",
        "expr": "smile"
       }
      ]
     },
     {
      "text": "Quantos de vocês existem?",
      "do": {
       "trust": {
        "edith": 1
       },
       "give": "edith_testemunho"
      },
      "then": [
       {
        "c": "say",
        "who": "edith",
        "text": "Quarenta e um. Alguns sabem. Os que não sabem são os mais felizes. Não tire isso deles à toa.",
        "expr": "sad"
       }
      ]
     }
    ]
   },
   {
