   },
   {
    "c": "say",
    "who": "player",
    "text": "Tinha uma coisa na praça. Sem rosto.",
    "expr": "scared",
    "by_char": {
     "elias": "Tinha uma coisa na praça. E o rádio do meu pai disse meu nome.",
     "theo": "Eu já vi gente morrer no plantão. Aquilo não estava vivo nem morto."
    }
   },
   {
    "c": "say",
    "who": "edith",
    "text": "Os vazios. Os que foram levados. Andam por onde andavam em vida.",
