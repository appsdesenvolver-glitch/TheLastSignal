       }
      },
      "then": [
       {
        "c": "say",
        "who": "edith",
        "text": "Você é corajosa, querida. Mas coragem demais aqui é perigoso.",
        "expr": "sad",
        "by_char": {
         "elias": "Você é igual ao seu pai. Ele também me contava tudo.",
         "theo": "Você é corajoso, rapaz. Mas coragem demais aqui é perigoso."
        }
       }
      ]
     },
     {
      "text": "Perguntar como ela sabe disso.",
      "do": {
       "set": "suspect_edith"
      },
      "then": [
       {
        "c": "say",
        "who": "edith",
        "text": "...Eu sirvo café em Ravenhill há muito tempo. A gente ouve coisas.",
